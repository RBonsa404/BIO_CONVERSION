# Variables d'environnement de BioConversion (production : Railway ou docker-compose).
# Copier ce fichier en .env pour docker-compose ; sur Railway, les saisir dans l'onglet
# « Variables » du service. Aucune n'est obligatoire pour démarrer.

# ── Base de données ──────────────────────────────────────────────────────────
# Railway : référencer la base du projet -> DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base

# ── Sécurité ─────────────────────────────────────────────────────────────────
# Secret de signature des jetons (32 caractères minimum). Sans lui, un secret aléatoire
# est tiré à chaque démarrage : les utilisateurs doivent se reconnecter après un redéploiement.
# JWT_SECRET=une-longue-phrase-secrete-de-32-caracteres-minimum
# Secret HMAC du webhook de l'opérateur de paiement, clé d'API des capteurs IoT.
# WEBHOOK_SECRET=
# IOT_API_KEY=
# Origines autorisées si un autre site appelle l'API (inutile en usage normal).
# ALLOWED_ORIGINS=

# ── Premier démarrage ────────────────────────────────────────────────────────
# Compte administrateur créé s'il n'existe pas (mot de passe : 8 caractères minimum).
# ADMIN_TELEPHONE=+22670000000
# ADMIN_MOT_DE_PASSE=
# Comptes et catalogue de démonstration (mot de passe public : à réserver aux démonstrations).
# DEMO_DATA=true

# ── Paiement ─────────────────────────────────────────────────────────────────
# true : la confirmation Orange Money est simulée depuis l'interface (aucun débit réel).
# Passer à false quand le webhook de l'agrégateur est branché.
# PAIEMENT_SIMULATION=true
# COMMISSION_TAUX=0.05

# ── Mentions des factures ────────────────────────────────────────────────────
# ENTREPRISE_NOM=BIO CONVERSION
# ENTREPRISE_IFU=
# ENTREPRISE_RCCM=
# ENTREPRISE_ADRESSE=Ouagadougou, Burkina Faso
# ENTREPRISE_TELEPHONE=
# ENTREPRISE_EMAIL=contact@bioconversion.bf
# ENTREPRISE_BANQUE=
# ENTREPRISE_IBAN=

# ── Divers ───────────────────────────────────────────────────────────────────
# SWAGGER_ENABLED=false
